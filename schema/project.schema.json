{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "设计思维项目数据",
  "description": "所有阶段共用的一份项目 JSON。每个模板只读取自己的部分；缺失的部分可以省略。详见 references/tools-index.md。",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "description": "项目名，也用于浏览器本地保存的键"
        },
        "challenge": {
          "type": "string",
          "description": "设计挑战"
        },
        "phase": {
          "enum": [
            "empathize",
            "define",
            "ideate",
            "prototype",
            "test",
            "reflect"
          ]
        },
        "macro": {
          "enum": [
            "diverge",
            "pivot",
            "converge"
          ]
        },
        "generatedBy": {
          "enum": [
            "ai",
            "mixed",
            "human"
          ],
          "description": "ai=AI 假设；mixed=调研+AI 推断；human=基于真实调研"
        },
        "updatedAt": {
          "type": "string"
        },
        "domainTerms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "方案词检查白名单：列出项目领域内的正常词汇（如医疗类'系统'、硬件类'设备'），validate 检查时跳过这些词"
        }
      }
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatar": {
