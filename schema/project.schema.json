        "macro": {
          "enum": [
            "diverge",
            "pivot",
            "converge"
          ]
        },
        "generatedBy": {
          "enum": [
            "ai",
            "mixed",
            "human"
          ],
          "description": "ai=AI 假设；mixed=调研+AI 推断；human=基于真实调研"
        },
        "updatedAt": {
