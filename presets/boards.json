 "brainstorm": {
  "title": "头脑风暴墙",
  "en": "Brainstorming",
  "phase": "ideate",
  "intro": "规则：先追求数量、不批评、鼓励疯狂的点子、在别人的点子上延伸、一次一个人说、尽量画出来。计时结束后投票。",
  "cols": 3,
  "timer": {
   "minutes": 10
  },
  "voting": {
   "enabled": true,
   "perPerson": 3
  },
  "steps": [
   "热身：用一个轻松的问题打开思路",
   "明确 HMW 问题",
   "独立写点子（每张卡一个）",
   "轮流分享、在别人点子上延伸",
   "聚类与投票",
   "挑选进入下一步的点子"
  ],
  "columns": [
   {
    "key": "wild",
    "title": "大胆疯狂的",
    "hint": "不考虑限制",
    "color": "pink"
   },
   {
    "key": "doable",
    "title": "马上能做的",
    "hint": "低成本、可快速验证",
    "color": "green"
   },
   {
    "key": "build",
    "title": "在别人点子上延伸",
    "hint": "“是的，而且……”",
    "color": "blue"
   }
  ],
  "cards": {
   "wild": [],
   "doable": [],
   "build": []
  }
 },
