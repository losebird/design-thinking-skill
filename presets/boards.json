   },
   {
    "key": "p",
    "title": "系统 · 过去",
    "hint": "过去用户如何完成这件事？",
    "color": "blue"
   },
   {
    "key": "n",
    "title": "系统 · 现在",
    "hint": "现在的产品/服务/做法",
    "color": "blue"
   },
   {
    "key": "f",
    "title": "系统 · 未来",
    "hint": "未来理想的方式",
    "color": "blue"
   },
   {
    "key": "bp",
    "title": "子系统 · 过去",
    "hint": "过去的组成部件/步骤",
    "color": "teal"
   },
   {
    "key": "bn",
    "title": "子系统 · 现在",
    "hint": "现在的关键部件/步骤",
