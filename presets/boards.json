 "workshop": {
  "title": "原型工作坊",
  "en": "Prototype Workshop",
  "phase": "prototype",
  "intro": "用时间盒子施加压力，快速产出原型。演示后收集红色（希望改进）与绿色（喜欢）反馈，再迭代。",
  "cols": 4,
  "timer": {
   "minutes": 30
  },
  "steps": [
   "定义要测试的核心功能",
   "构思不同变体",
   "动手制作原型（时间盒子）",
   "向其他小组演示",
   "收集红/绿反馈",
   "根据反馈改进",
   "准备真实用户测试"
  ],
  "columns": [
   {
    "key": "feature",
